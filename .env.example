# GTPS Server Configuration
GTPS_LOGIN_URL=http://127.0.0.1/growtopia/server_data.php
GTPS_USE_HTTPS=false
GTPS_GAME_SERVER=127.0.0.1
GTPS_GAME_PORT=17091

# Account Credentials (kosongkan jika ingin diatur langsung lewat GUI Lucifer)
ACCOUNT_NAME=
ACCOUNT_PASSWORD=

# Client Configuration
CLIENT_VERSION=5.58
CLIENT_PLATFORM=windows
CLIENT_PROTOCOL=225
TARGET_WORLD=

# Logging
LOG_VERBOSE=true
LOG_HEXDUMP=false

# SOCKS5 Proxy Configuration (Opsional: kosongkan untuk koneksi Direct)
# Format cepat (Quick Paste): host:port:username:password atau host:port
SOCKS5_PROXY=
# Atau konfigurasi terpisah:
SOCKS5_ENABLED=false
SOCKS5_HOST=
SOCKS5_PORT=1080
SOCKS5_USERNAME=
SOCKS5_PASSWORD=

